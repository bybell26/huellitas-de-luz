# Copia este archivo a .env y completa los valores

# PostgreSQL
DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/huellitas

# JWT — genera uno seguro con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=7d

# Servidor
PORT=4000
NODE_ENV=development

# Pey — tu API key (nunca la subas al repo)
PEY_API_KEY=tu_api_key_de_pey

# CORS — origenes permitidos (separados por coma)
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:19006
